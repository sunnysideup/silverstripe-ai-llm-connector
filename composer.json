{
  "name": "sunnysideup/ai-llm-connector",
  "description": "Sets up a unified way to connect to google, anthropic, and the not so nice chatgpt",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "ai",
    "llm",
    "anthropic",
    "chatgpt",
    "gemini",
    "connector",
    "keep it simple"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^5.0",
    "silverstripe/admin": "^2.0"
  },
  "require-dev": {},
  "suggest": {
    "openai-php/client": "Required for the OpenAI connector",
    "mozex/anthropic-php": "Required for the Claude connector",
    "google-gemini-php/client": "Required for the Gemini connector"
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\AiLlmConnector\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
